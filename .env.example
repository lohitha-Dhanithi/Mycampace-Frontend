# MyCampace Frontend Environment Variables Template

# Custom Domain Backend:
VITE_API_URL=http://devbackend.mycampace.com/api
VITE_API_DOCS_URL=http://devbackend.mycampace.com/api/docs

# (Switch to https:// once SSL is provisioned):
# VITE_API_URL=https://devbackend.mycampace.com/api

# Direct EC2 IP Fallback:
# VITE_API_URL=http://13.201.185.13/api

# Local Development Backend:
# VITE_API_URL=http://localhost:4000/api

# Next.js local API + live auth/onboarding (recommended for backend integration):
# NEXT_PUBLIC_API_URL=http://localhost:4000/api
# NEXT_PUBLIC_API_DOCS_URL=http://localhost:4000/api/docs
# NEXT_PUBLIC_USE_PLATFORM_API=true
